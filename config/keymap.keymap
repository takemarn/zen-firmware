#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * ZEN キーマップ
 *  0: 基本
 *  1: マウス（トラックボールを動かすと自動でON）J=戻る K=再読み込み L=進む（⌘[ ⌘R ⌘] / JIS前提）
 *  2: 矢印（キーボールのMO(1)）
 *  3: 数字・記号（キーボールのMO(2)）※記号はMacのキーボード種類=JIS前提
 *  4: スクロール（押している間、ボールでスクロール）
 *  5: システム（Bluetooth切替・Fキー・テンキー）※右下の親指キーで呼び出し
 *  6: マウス固定（Nの左のキーでON/OFF。もう一回押すまでマウスモードのまま）
 */

/ {
    macros {
        // Q+W+E：⌘⇧4 → 200ms待ち → スペース（ウインドウのスクリーンショット）

        ss_window: ss_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LS(LG(N4))>, <&macro_wait_time 200>, <&kp SPACE>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // ---- 日本語入力 ----

        kana {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp LANG1>;
            layers = <0 1 6>;
        };       // J+K → かな
        eisu {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LANG2>;
            layers = <0 1 6>;
        };       // D+F → 英数
        // ---- マウス ----
        // M+, → 左クリック       // ,+. → 右クリック           // .+/ → 押している間スクロール
        // ---- 編集 ----

        cut {
            timeout-ms = <50>;
            key-positions = <25 26>;
            bindings = <&kp LG(X)>;
            layers = <0 1 6>;
        };       // Z+X → カット
        copy {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp LG(C)>;
            layers = <0 1 6>;
        };       // X+C → コピー
        paste {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp LG(V)>;
            layers = <0 1 6>;
        };       // C+V → 貼り付け
        cliphist {
            timeout-ms = <50>;
            key-positions = <26 28>;
            bindings = <&kp LC(LG(V))>;
            layers = <0 1 6>;
        }; // X+V → クリップボード履歴
        minus {
            timeout-ms = <50>;
            key-positions = <9 10>;
            bindings = <&kp MINUS>;
            layers = <0 1 6>;
        };        // O+P → -
        // ---- スクリーンショット ----

        ss_full {
            timeout-ms = <50>;
            key-positions = <1 2 3 4>;
            bindings = <&kp LS(LG(N3))>;
            layers = <0 1 6>;
        }; // Q+W+E+R → ⌘⇧3
        ss_win {
            timeout-ms = <50>;
            key-positions = <1 2 3>;
            bindings = <&ss_window>;
            layers = <0 1 6>;
        };       // Q+W+E → ウインドウ
        ss_area {
            timeout-ms = <50>;
            key-positions = <2 3 4>;
            bindings = <&kp LS(LG(N4))>;
            layers = <0 1 6>;
        };   // W+E+R → ⌘⇧4
        ss_panel {
            timeout-ms = <50>;
            key-positions = <2 3 4 5>;
            bindings = <&kp LS(LG(N5))>;
            layers = <0 1 6>;
        }; // W+E+R+T → ⌘⇧5
        // ---- ウインドウ・タブ ----

        app_switch {
            timeout-ms = <50>;
            key-positions = <7 8 9>;
            bindings = <&kp LG(TAB)>;
            layers = <0 1 6>;
        };       // U+I+O → アプリ切替
        mission {
            timeout-ms = <50>;
            key-positions = <7 8 9 10>;
            bindings = <&kp LC(UP)>;
            layers = <0 1 6>;
        };     // U+I+O+P → Mission Control
        close_win {
            timeout-ms = <50>;
            key-positions = <8 9 10>;
            bindings = <&kp LS(LG(W))>;
            layers = <0 1 6>;
        };    // I+O+P → ウインドウを閉じる
        close_tab {
            timeout-ms = <50>;
            key-positions = <9 10 11>;
            bindings = <&kp LG(W)>;
            layers = <0 1 6>;
        };       // O+P+BS → タブを閉じる
        minimize {
            timeout-ms = <50>;
            key-positions = <33 34 35>;
            bindings = <&kp LG(M)>;
            layers = <0 1 6>;
        };   // M+,+. → 最小化
        back {
            timeout-ms = <50>;
            key-positions = <32 33 34>;
            bindings = <&kp LG(RBKT)>;
            layers = <0 1 6>;
        }; // N+M+,
        forward {
            timeout-ms = <50>;
            key-positions = <34 35 36>;
            bindings = <&kp LG(NON_US_HASH)>;
            layers = <0 1 6>;
        };   // ,+./
        // ---- ⌃⌥ 系（ウインドウ配置など）----

        cae_enter {
            timeout-ms = <50>;
            key-positions = <19 20 21 22>;
            bindings = <&kp LC(LA(RET))>;
            layers = <0 1 6>;
        };   // J+K+L+; → ⌃⌥Enter
        cae_left {
            timeout-ms = <50>;
            key-positions = <18 19 20 21>;
            bindings = <&kp LC(LA(LEFT))>;
            layers = <0 1 6>;
        };  // H+J+K+L → ⌃⌥←
        cae_right {
            timeout-ms = <50>;
            key-positions = <20 21 22 23>;
            bindings = <&kp LC(LA(RIGHT))>;
            layers = <0 1 6>;
        }; // K+L+;+Enter → ⌃⌥→
        cae_j {
            timeout-ms = <50>;
            key-positions = <18 19 20>;
            bindings = <&kp LC(LA(J))>;
            layers = <0 1 6>;
        };        // H+J+K → ⌃⌥J
        cae_l {
            timeout-ms = <50>;
            key-positions = <20 21 22>;
            bindings = <&kp LC(LA(L))>;
            layers = <0 1 6>;
        };        // K+L+; → ⌃⌥L
        f13 {
            timeout-ms = <50>;
            key-positions = <19 20 21>;
            bindings = <&kp F13>;
            layers = <0 1 6>;
        };              // J+K+L → F13
        // ---- ZEN標準：システムレイヤーで V+B → 今のBT接続先をクリア ----

        bt_clear {
            key-positions = <28 29>;
            bindings = <&bt BT_CLR>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E         &kp R          &kp T      &kp Y  &kp U   &kp I  &kp O  &kp P      &kp BSPC
&kp TAB    &kp A     &kp S     &kp D         &kp F          &kp G      &kp H  &kp J   &kp K  &kp L  &kp SEMI   &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C         &kp V          &kp B      &mo 3  &tog 6  &kp N  &kp M  &kp COMMA  &kp DOT            &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LALT  &kp LGUI  &kp LEFT_GUI  &kp LC(SPACE)  &kp SPACE  &none  &mo 2   &mo 3  &mo 5  &kp N1     &kp LC(LG(SPACE))
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans     &trans               &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(RBKT)  &kp LG(R)  &kp LG(NON_US_HASH)  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans     &mkp LCLK            &mkp RCLK  &mo 4   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans     &trans               &trans     &trans
            >;
        };

        arrow_layer {
            display-name = "Arrow";
            bindings = <
&trans  &none   &none     &kp UP    &none            &none   &none   &none     &kp UP    &none         &kp MINUS     &kp DEL
&trans  &none   &kp LEFT  &kp DOWN  &kp RIGHT_ARROW  &none   &none   &kp LEFT  &kp DOWN  &kp RIGHT     &kp KP_PLUS   &trans
&trans  &none   &none     &none     &none            &none   &trans  &trans    &none     &kp LC(LALT)  &kp LC(LGUI)  &kp LA(LGUI)  &kp FSLH  &kp INT1
&trans  &trans  &trans    &trans    &trans           &trans  &trans  &trans    &trans    &trans        &trans        &trans
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&trans  &none   &none   &none   &none   &none   &none   &kp N7  &kp N8  &kp N9      &kp MINUS    &kp LEFT_BRACKET
&trans  &none   &none   &none   &none   &none   &none   &kp N4  &kp N5  &kp N6      &kp KP_PLUS  &kp SQT
&trans  &none   &none   &none   &none   &none   &trans  &trans  &kp N0  &kp N1      &kp N2       &kp N3            &kp FSLH  &kp INT1
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &kp N0  &kp KP_DOT  &none        &none
            >;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_USB  &out OUT_BLE  &trans  &trans  &trans   &trans   &trans
            >;
        };

        mouse_lock_layer {
            display-name = "MouseLock";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans     &trans               &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(RBKT)  &kp LG(R)  &kp LG(NON_US_HASH)  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans     &mkp LCLK            &mkp RCLK  &mo 4   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans     &trans               &trans     &trans
            >;
        };
    };
};
